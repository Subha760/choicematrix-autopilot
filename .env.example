# Keep real credentials only in the production VM .env (chmod 600).
TG_BOT_TOKEN=
TG_APPROVER_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_PROVIDER_ORDER=gemini,groq
META_PAGE_TOKEN=
META_API_VERSION=v26.0
FB_PAGE_ID=
IG_USER_ID=
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
UNSPLASH_ACCESS_KEY=
# Enable only on the one persistent production host after migration/preflight.
ALLOW_LOCAL_PUBLISH=false
MEDIA_SYNC_ENABLED=false
MEDIA_GIT_BRANCH=main
GITHUB_REPOSITORY=Subha760/choicematrix-autopilot
# PUBLIC_BASE_URL=optional public URL serving exact JPEG bytes
# AUTOPILOT_STATE_DIR=optional private directory; copy legacy JSON here before first run
